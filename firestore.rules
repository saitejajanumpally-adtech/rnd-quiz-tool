rules_version = '2';

// R&D Quiz Arena security rules.
// These rules are the only protection for your data, so please read SETUP-GUIDE.md before changing them.
// The email below is the permanent first admin. It must match "bootstrapAdmin" in src/config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- who is signed in, and what they are allowed to be ----------
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@databeat[.]io');
    }
    function me() { return request.auth.token.email.lower(); }
    function roleOf() {
      return exists(/databases/$(database)/documents/roles/$(me()))
        ? get(/databases/$(database)/documents/roles/$(me())).data.role
        : 'participant';
    }
    function isAdmin()   { return signedIn() && (me() == 'saiteja.janumpally@databeat.io' || roleOf() == 'admin'); }
    function isCreator() { return signedIn() && roleOf() == 'creator'; }
    function isLead()    { return signedIn() && roleOf() == 'lead'; }
    function isStaff()   { return isAdmin() || isCreator(); }

    // A person who removed their profile cannot start or change answers until they sign in again.
    // Their past answers and scores are not touched.
    function profileActive() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('deleted', false) != true;
    }

    // ---------- quiz helpers ----------
    function isArchived(q) {
      return get(/databases/$(database)/documents/quizKeys/$(q)).data.get('archived', false) == true;
    }
    // Released AND not archived.
    function released(q) {
      let k = get(/databases/$(database)/documents/quizKeys/$(q)).data;
      return k.released == true && k.get('archived', false) != true;
    }
    // Admins see everything. Creators see everything except archived quizzes.
    function staffSees(q) { return isAdmin() || (isStaff() && !isArchived(q)); }
    // Every creator can edit every quiz (agreed). Only admins can archive, restore or delete.
    function canEditQuiz(q) { return isAdmin() || isCreator(); }
    function archiveUnchanged() {
      return request.resource.data.get('archived', false) == resource.data.get('archived', false);
    }
    function quizOpen(q) {
      let z = get(/databases/$(database)/documents/quizzes/$(q)).data;
      return z.published == true
        && z.get('archived', false) != true
        && request.time.toMillis() >= z.opens
        && request.time.toMillis() < z.closes;
    }
    function leaderboardSetting() {
      return exists(/databases/$(database)/documents/settings/app)
        ? get(/databases/$(database)/documents/settings/app).data.leaderboardVisibility
        : 'leads';
    }

    // ---------- roles: only people with extra access are listed ----------
    match /roles/{e} {
      allow get: if signedIn() && (e == me() || isStaff());
      allow list: if isStaff();
      allow create, update: if request.resource.data.role in ['lead', 'creator', 'admin']
        && (isAdmin()
            || (isCreator() && request.resource.data.role == 'lead'
                && (resource == null || resource.data.role == 'lead')));
      allow delete: if isAdmin() || (isCreator() && resource.data.role == 'lead');
    }

    match /settings/{d} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // The Library list everyone sees is quizIndex/main. Archived quizzes live in quizIndex/archived, which only admins can read or write.
    match /quizIndex/{d} {
      allow read: if signedIn() && (d != 'archived' || isAdmin());
      allow write: if (d != 'archived' && isStaff()) || (d == 'archived' && isAdmin());
    }

    // ---------- quizzes: questions are readable only once the quiz has opened ----------
    match /quizzes/{id} {
      allow get: if signedIn() && (
          isAdmin()
          || (resource.data.get('archived', false) != true
              && (isStaff() || (resource.data.published == true && request.time.toMillis() >= resource.data.opens))));
      // the app never lists this collection; only admins may
      allow list: if isAdmin();
      allow create: if isAdmin() || (isCreator() && request.resource.data.ownerEmail == me());
      allow update: if isAdmin() || (isCreator() && archiveUnchanged());
      // admin-only delete, and only for quizzes that were never released (the app also refuses if anyone has responded)
      allow delete: if isAdmin()
        && !(exists(/databases/$(database)/documents/quizKeys/$(id))
             && get(/databases/$(database)/documents/quizKeys/$(id)).data.released == true);
    }

    // the answer key (correct answers, rubrics, explanations): staff, or everyone after release
    match /quizKeys/{id} {
      allow get: if signedIn() && (
          isAdmin()
          || (resource.data.get('archived', false) != true && (resource.data.released == true || isStaff())));
      allow list: if isAdmin();
      allow create: if canEditQuiz(id);
      allow update: if isAdmin() || (canEditQuiz(id) && archiveUnchanged());
      allow delete: if isAdmin();
    }

    // ---------- responses: one per person per quiz; locked once submitted or closed ----------
    match /responses/{rid} {
      // Raw answers of an archived quiz can be read by admins only. Creators keep their access to active quizzes.
      allow get: if signedIn() && (rid.matches('.*_' + request.auth.uid) || staffSees(resource.data.quizId));
      allow list: if staffSees(resource.data.quizId);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && rid == request.resource.data.quizId + '_' + request.auth.uid
        && request.resource.data.email == me()
        && request.resource.data.submitted == false
        && request.resource.data.keys().hasOnly(['quizId', 'uid', 'email', 'name', 'answers', 'submitted', 'startedAt', 'updatedAt'])
        && quizOpen(request.resource.data.quizId)
        && profileActive();
      // the person's own branch comes first: it is the common case and costs the fewest database reads
      allow update: if (signedIn()
            && resource.data.uid == request.auth.uid
            && resource.data.submitted == false
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['answers', 'updatedAt', 'submitted', 'submittedAt'])
            && quizOpen(resource.data.quizId)
            && profileActive())
        || isStaff();
      allow delete: if isAdmin();
    }

    // ---------- results: written by staff, readable only after release ----------
    match /myResults/{rid} {
      allow get: if signedIn() && ((rid.matches('.*_' + request.auth.uid) && (resource == null || released(resource.data.quizId)))
        || isAdmin()
        || (isStaff() && resource != null && !isArchived(resource.data.quizId)));
      allow list: if isAdmin();
      allow write: if isStaff();
    }
    match /resultsPublic/{q} {
      allow get: if signedIn() && (released(q) || staffSees(q));
      allow write: if isStaff();
    }
    match /resultsFull/{q} {
      allow get: if signedIn() && ((released(q) && ((isLead() && leaderboardSetting() != 'staff') || leaderboardSetting() == 'everyone'))
        || staffSees(q));
      allow write: if isStaff();
    }
    match /stats/{u} {
      allow get: if signedIn() && (u == request.auth.uid || isStaff());
      allow write: if isStaff();
    }
    match /writtenScores/{id} {
      allow read, write: if isStaff();
    }

    // ---------- people ----------
    // A person reads their own record; staff read any single record; only admins can list everyone (Users export).
    // "Delete my account" sets deleted = true. The record stays, so admins keep the full history.
    // Nobody can delete a user record or change another person's.
    match /users/{u} {
      allow get: if signedIn() && (u == request.auth.uid || isStaff());
      allow list: if isAdmin();
      allow create: if signedIn() && u == request.auth.uid
        && request.resource.data.email == me()
        && request.resource.data.keys().hasOnly(['name', 'email', 'lastSeen', 'firstSeen', 'prefs', 'deleted', 'deletedAt'])
        && request.resource.data.get('deleted', false) == false;
      allow update: if signedIn() && u == request.auth.uid
        && request.resource.data.email == me()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'email', 'lastSeen', 'prefs', 'deleted', 'deletedAt']);
      allow delete: if false;
    }

    // A tiny public marker so leaderboards can grey the name of someone who removed their profile.
    // It holds no personal details, and a person can only add or remove their own.
    match /profileStatus/{u} {
      allow read: if signedIn();
      allow create, update: if signedIn() && u == request.auth.uid
        && request.resource.data.keys().hasOnly(['removed', 'at'])
        && request.resource.data.removed == true;
      allow delete: if signedIn() && u == request.auth.uid;
    }

    // ---------- requests, log and outbox ----------
    match /reviewRequests/{id} {
      allow get: if signedIn() && (isStaff() || resource.data.uid == request.auth.uid);
      allow list: if signedIn() && (isStaff() || resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == me() && request.resource.data.status == 'open';
      allow update: if isStaff();
    }
    match /accessRequests/{id} {
      allow read: if isStaff();
      allow create: if isCreator() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
    }
    match /changeLog/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.by == me();
      allow update, delete: if false;
    }
    match /outbox/{id} {
      allow read, create, update: if isStaff();
    }
  }
}
